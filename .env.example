# 別のスプレッドシートや別の GCP クライアント ID で動かしたいときは、
# このファイルを .env.local としてコピーして値を書き換える（.env.local は git 管理外）。
# 未設定なら src/constants.js と src/index.jsx の既定値（本番の家計簿）を使う。
#
# ここに書く値はビルド成果物に埋め込まれて公開されるため、秘密情報は入れないこと。
# 特に client_secret は SPA では使わないので絶対に置かない。

VITE_SPREADSHEET_ID=
VITE_SHEET_NAME=data
VITE_GOOGLE_CLIENT_ID=
